{
  "name": "founders-circle",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm --prefix Frontend run dev",
    "build": "prisma generate && npm --prefix Frontend run build && tsc -p tsconfig.server.json",
    "start": "node Backend/dist/src/server.js",
    "lint": "eslint Frontend/src server prisma tests scripts/*.ts",
    "db:generate": "prisma generate",
    "dev:server": "tsx watch Backend/src/server.ts",
    "db:local": "node Backend/scripts/local-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx Backend/prisma/seed.ts",
    "db:reset": "prisma migrate reset --skip-seed && tsx Backend/prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 Backend/tests/*.test.ts",
    "test:browser": "node Backend/scripts/browser-qa.mjs && node Backend/scripts/onboarding-qa.mjs",
    "db:taxonomy": "tsx Backend/scripts/seed-taxonomy.ts",
    "db:seed:community": "tsx Backend/scripts/seed-community.ts",
    "test:community:browser": "node Backend/scripts/community-qa.mjs",
    "admin:create": "tsx Backend/scripts/bootstrap-admin.ts",
    "college:add": "tsx Backend/scripts/add-college.ts",
    "format": "prettier --write client server prisma/*.ts tests scripts/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.31.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.3",
    "prisma": "^6.19.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitejs/plugin-react": "6.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.4",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
