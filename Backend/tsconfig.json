{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "prisma/*.ts",
    "tests/*.ts",
    "scripts/*.ts"
  ]
}
