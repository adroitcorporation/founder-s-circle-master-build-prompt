DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require&connection_limit=5
# Prisma migrations use a direct connection or Supabase session pooler (5432).
# Runtime may use the same session pooler; keep both credentials server-side.
DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
TRUST_PROXY=0
# Opaque, random, server-stored sessions; no JWT secret required.
# Local development only: email links are written to work/mail (never served).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Alternative HTTPS delivery for hosts that block SMTP (server-side only).
RESEND_API_KEY=
EMAIL_FROM=Founder’s Circle <noreply@example.com>
# Production requires a private S3 bucket and HTTPS. Standard AWS credentials.
S3_BUCKET=founders-circle-private
S3_REGION=ap-south-1
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# Set supabase for Supabase S3 compatibility; default uses AWS SSE headers.
S3_PROVIDER=supabase
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_DIR=work/uploads
# Set only for development seeding; never seed sample users in production.
SEED_PASSWORD=
